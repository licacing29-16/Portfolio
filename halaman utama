<style>
:root{
  --blue:#2D47A6; --cream:#FAF6F0; --ink:#1B1A17; --muted:#4A473F;
  --yellow:#FFCB2F; --line:#E6DFD3; --pad:clamp(20px,5vw,64px);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--cream);color:var(--ink);font-family:'Poppins',system-ui,sans-serif;line-height:1.55}
a{color:inherit}
a:focus-visible{outline:3px solid var(--yellow);outline-offset:3px}
.wrap{max-width:1240px;margin:0 auto;padding-left:var(--pad);padding-right:var(--pad)}
h1,h2,h3{margin:0}
h2{font-size:clamp(34px,5vw,52px);font-weight:800;letter-spacing:-1px;line-height:1.1}

/* nav */
nav{display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;padding-top:24px;padding-bottom:24px}
.brand{font-weight:800;font-size:22px;text-decoration:none;color:var(--blue)}
.links{display:flex;flex-wrap:wrap;gap:8px 24px;align-items:center;font-size:15px;font-weight:600}
.links a{text-decoration:none;padding:10px 0}
.links .pill{padding:10px 20px;background:var(--blue);color:#fff;border-radius:999px}

/* buttons */
.btn{display:inline-block;text-decoration:none;font-weight:600;padding:16px 32px;border-radius:999px;border:2px solid transparent;transition:transform .15s}
.btn:hover{transform:translateY(-2px)}
.btn.solid{background:var(--blue);color:#fff}
.btn.line{border-color:var(--blue);color:var(--blue)}

/* hero */
header.hero{display:flex;flex-wrap:wrap;gap:48px;align-items:center;padding-top:48px;padding-bottom:96px}
.hero .text{flex:1 1 440px}
.hero .kicker{margin:0 0 16px;font-size:15px;font-weight:600;color:#5A5750}
.hero h1{font-size:clamp(48px,8vw,96px);line-height:1;font-weight:800;letter-spacing:-2px;color:var(--blue)}
.hero .lead{margin:24px 0 0;font-size:20px;max-width:560px;color:#3B3932}
.hero .cta{display:flex;flex-wrap:wrap;gap:16px;margin-top:36px}
.hero .art{flex:1 1 320px;display:flex;justify-content:center}
.blob{position:relative;width:min(380px,100%);aspect-ratio:1/1.1}
.blob .shape{position:absolute;inset:0;background:var(--blue);border-radius:48% 52% 44% 56%/52% 44% 56% 48%}
.blob .dot{position:absolute;right:-8px;top:24px;width:96px;height:96px;background:var(--yellow);border-radius:50%}
.blob .photo{position:absolute;inset:36px;border-radius:32px;background:#E8E1D4;overflow:hidden;display:flex;align-items:center;justify-content:center;text-align:center;color:#5A5750;font-size:14px;font-weight:600}
.blob .photo img{width:100%;height:100%;object-fit:cover}

/* stats */
.stats{background:var(--blue);color:#fff;padding-top:64px;padding-bottom:64px}
.stats .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:32px}
.stats strong{display:block;font-size:56px;font-weight:800;line-height:1;color:var(--yellow)}
.stats p{margin:8px 0 0;font-size:15px}

/* work */
#work{padding-top:96px;padding-bottom:48px}
#work .intro{margin:12px 0 48px;font-size:17px;color:var(--muted);max-width:620px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px}
.card{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden}
.card .cover{height:150px;display:flex;align-items:flex-end;padding:20px;font-weight:800;font-size:28px;color:#fff}
.card .cover img{width:100%;height:100%;object-fit:cover}
.card .body{padding:20px 22px 24px}
.card .tag{margin:0 0 6px;font-size:13px;font-weight:600;color:#5A5750}
.card h3{font-size:19px;margin-bottom:8px}
.card p.desc{margin:0;font-size:14.5px;color:var(--muted)}

/* about */
#about{display:flex;flex-wrap:wrap;gap:48px;padding-top:96px;padding-bottom:96px}
#about .title{flex:1 1 320px}
#about .content{flex:2 1 460px}
#about .big{margin:0 0 20px;font-size:19px;color:#3B3932}
#about .sub{margin:0 0 28px;font-size:17px;color:var(--muted)}
.chips{display:flex;flex-wrap:wrap;gap:10px;padding:0;margin:0;list-style:none}
.chips li{padding:8px 18px;border-radius:999px;background:#fff;border:1px solid var(--line);font-size:14px;font-weight:600}

/* experience */
#experience{padding-bottom:96px}
#experience h2{margin-bottom:40px}
.timeline{border-top:2px solid var(--ink)}
.row{display:flex;flex-wrap:wrap;gap:16px 48px;padding:28px 0;border-bottom:1px solid #D8D0C2}
.row .when{flex:1 1 200px;font-weight:600;color:var(--blue)}
.row .what{flex:3 1 400px}
.row h3{font-size:22px}
.row .org{margin:4px 0 8px;font-weight:600;color:#5A5750}
.row p.d{margin:0;font-size:15.5px;color:var(--muted)}

/* contact */
#contact{background:var(--blue);color:#fff;padding-top:96px;padding-bottom:96px}
#contact h2{font-size:clamp(44px,8vw,88px);line-height:1.05;letter-spacing:-2px}
#contact .lead{margin:24px 0 40px;font-size:19px;max-width:560px}
#contact .actions{display:flex;flex-wrap:wrap;gap:16px}
#contact .btn.yellow{background:var(--yellow);color:var(--ink)}
#contact .btn.outline{border-color:#fff;color:#fff}
#contact .foot{margin:64px 0 0;font-size:14px;opacity:.9}

@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.btn{transition:none}}
</style>
</head>
